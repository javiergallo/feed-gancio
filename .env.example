### Config

# CLASSIFIER_MODEL="joeddav/xlm-roberta-large-xnli"
# LLAMA_MODEL_PATH="./llama-3.2-1b-instruct-q8_0.gguf"
# PROMPT_CONTEXT_MAX_LENGTH=1024
# TEMPERATURE=0.0
# IMAGE_SELECTOR="img"
# LOCALE=null
# HYPOTHESIS_TEMPLATE="This example is {}."
# ASSUME_SCHEDULABLE_EVENT=false
# SCHEDULABLE_EVENT_MIN_SCORE=0.4
# SCHEDULABLE_EVENT_LABEL="schedulable event"
# OTHER_CANDIDATE_LABELS=["news","statement"]
# DATE_FORMAT="%A, %B %d, %Y"
# TIME_FORMAT="%H hours and %M minutes"
# START_KEY="start"
# END_KEY="end"
# DATETIME_STRS_EXTRACTION_PROMPT_TEMPLATE="You are a helpful assistant that extracts date-time information from text. You will be given a text that refers to a schedulable event. You must extract the event's start date-time, and ending date-time if possible (empty string if not possible). You must return the extracted information in a JSON object with the following keys: {start_key} and {end_key}. The values of the keys must be strings. The date-time strings must be in a format that can be parsed by dateparser.parse(). Today's {today_str}, it's {now_str}. "
# DATETIME_EXTRACTION_PROMPT_TEMPLATE="You are a helpful assistant that extracts date-time information from text. You will be given a text that refers to date-time information. You must extract the date-time, ISO formatted. Today's {today_str}, it's {now_str}. "
