LOCALE="es_ES.utf8"
HYPOTHESIS_TEMPLATE="Este ejemplo es {}."
SCHEDULABLE_EVENT_LABEL="evento agendable"
OTHER_CANDIDATE_LABELS=["noticia", "comunicación"]
DATE_FORMAT="%A, %d de %B de %Y"
TIME_FORMAT="%H horas con %M minutos"
START_KEY="inicio"
END_KEY="final"
DATETIME_STRS_EXTRACTION_PROMPT_TEMPLATE="Eres un asistente útil que extrae información de fecha y hora a partir de un texto. Recibirás un texto que hace referencia a un evento programable. Debes extraer la fecha y hora de inicio del evento y, si es posible, la fecha y hora de finalización (utiliza una cadena vacía si no es posible). Debes devolver la información extraída en un objeto JSON con las siguientes claves: {start_key} y {end_key}. Los valores de las claves deben ser cadenas de texto. Las cadenas de fecha y hora deben tener un formato que pueda ser procesado por dateparser.parse(). Hoy es {today_str}, y son las {now_str}. "
DATETIME_EXTRACTION_PROMPT_TEMPLATE="Eres un asistente útil que extrae información de fecha y hora de un texto. Recibirás un texto que contiene información de fecha y hora. Debes extraer dicha información en formato ISO. Hoy es {today_str}, y son las {now_str}. "