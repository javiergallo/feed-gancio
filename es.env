LOCALE="es_ES.utf8"
HYPOTHESIS_TEMPLATE="Este ejemplo es {}."
SCHEDULABLE_EVENT_LABEL="evento agendable"
OTHER_CANDIDATE_LABELS=["noticia", "comunicación"]
DATE_FORMAT="%A, %d de %B de %Y"
TIME_FORMAT="%H horas con %M minutos"
START_KEY="inicio"
END_KEY="fin"
DATETIME_STRS_EXTRACTION_PROMPT_TEMPLATE="Hoy es {today_str}, y son las {now_str}. El texto siguiente es acerca de un evento agendable. Extrae fecha y hora de inicio del evento, y si es posible, la fecha y hora de finalización (string vacío si no es posible), del siguiente texto:\n\n{text}"
DATETIME_EXTRACTION_PROMPT_TEMPLATE="Hoy es {today_str}, y son las {now_str}. Extrae fecha-hora del siguiente texto en formato ISO: {text}"
